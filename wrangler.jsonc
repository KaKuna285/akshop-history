{
  // Explicit static-site config, so Cloudflare doesn't have to guess how to
  // serve this (its auto-detection was treating this like a single-page app
  // and serving unstyled content at "/" while 404ing on "/shoplist/").
  "name": "akshop-history",
  "compatibility_date": "2024-09-23",
  // Only runs for /mirror/* (see assets.run_worker_first): the R2-backed
  // copy of skin art and chibis (myrtle.moe, ArknightsAssets2). Every
  // other path is a plain static file and never invokes it.
  "main": "worker/index.js",
  "assets": {
    // Serve every file straight from the repo root -- this is a plain
    // static site, no build step, root-relative paths (/css/..., /js/...)
    // throughout.
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/mirror/*"],
    // Not a single-page app: a path with no matching file should get a
    // real 404, not silently fall back to some other page's content.
    "not_found_handling": "404-page",
    // "/shoplist" and "/shoplist/" should both resolve to
    // "/shoplist/index.html" (the actual page), same as any static file
    // server's default directory-index behavior.
    "html_handling": "auto-trailing-slash"
  },
  // The mirror's storage. The bucket is created once in the dashboard
  // (R2 -> Create bucket); see the README's Cloudflare setup section.
  "r2_buckets": [{ "binding": "MIRROR", "bucket_name": "akshop-mirror" }],
  // Caps how many files one visitor IP can make the mirror fetch from
  // its sources per minute (files already in R2 don't count). Opening a skin
  // preview needs at most ~10 new files, so 60 a minute only bites on
  // abuse. namespace_id must be unique within the Cloudflare account.
  "ratelimits": [
    { "name": "UPSTREAM_LIMITER", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
  ]
}
